# Copy this file to ".env" and fill in real values.
# ".env" is in .gitignore, so it never reaches GitHub.
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# Key for the plain-LLM baseline. A free one from https://console.groq.com
# works with the defaults below. Leave it empty and the app still runs;
# the LLM side of the comparison just says it is not connected.
LLM_API_KEY=
# Optional. Any provider with an OpenAI-compatible API that supports tool
# calling works. LLM_MODELS is a comma-separated list, tried in order.
# Defaults: https://api.groq.com/openai/v1 and
# openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
LLM_BASE_URL=
LLM_MODELS=
