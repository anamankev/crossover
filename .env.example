# Copy this file to ".env" and fill in real values.
# ".env" is in .gitignore, so it never reaches GitHub.
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# Anthropic API key for the plain-LLM baseline. Leave empty and the app
# still runs; the LLM side of the comparison just says it is not connected.
LLM_API_KEY=
# Optional. Defaults to claude-opus-5-5.
LLM_MODEL=
